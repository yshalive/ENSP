    <txttips>
        <txttip left="110" top="41" right="567" bottom="526" content="RouteA&#x0D;&#x0A;#&#x0D;&#x0A;sys&#x0D;&#x0A;#&#x0D;&#x0A;sysname RouterA&#x0D;&#x0A;#&#x0D;&#x0A;int Eth-Trunk 1 创建trunk组1&#x0D;&#x0A;#&#x0D;&#x0A;mode lacp-static 模式lacp静态&#x0D;&#x0A;#&#x0D;&#x0A;int g0/0/1 &#x0D;&#x0A;eth-trunk 1 接口加入trunk组&#x0D;&#x0A;#&#x0D;&#x0A;int g0/0/2&#x0D;&#x0A;eth-trunk 1&#x0D;&#x0A;#&#x0D;&#x0A;int g0/0/3&#x0D;&#x0A;eth-trunk 1&#x0D;&#x0A;#&#x0D;&#x0A;lacp priority 100系统优先级设置100使用lacp成为主动端&#x0D;&#x0A;#&#x09;&#x0D;&#x0A;[RouterA]int Eth-Trunk 1&#x0D;&#x0A;&#x0D;&#x0A;[RouterA-Eth-Trunk1]max active-linknumber 2 设置最大活动端口&#x0D;&#x0A;&#x0D;&#x0A;[RouterA]int g0/0/1&#x0D;&#x0A;[RouterA-GigabitEthernet0/0/1]lacp priority 100 设置接口等级&#x0D;&#x0A;&#x0D;&#x0A;[RouterA]int g0/0/2&#x0D;&#x0A;[RouterA-GigabitEthernet0/0/2]lacp priority 100&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
        <txttip left="932" top="51" right="1238" bottom="427" content="RouterB&#x0D;&#x0A;#&#x0D;&#x0A;&lt;Huawei&gt;sys&#x0D;&#x0A;[Huawei]un in en&#x0D;&#x0A;&#x0D;&#x0A;[Huawei]sysna RouteB&#x0D;&#x0A;&#x09;&#x0D;&#x0A;[RouteB]int Eth-Trunk 1&#x0D;&#x0A;&#x0D;&#x0A;&#x09;&#x0D;&#x0A;&#x0D;&#x0A;[RouteB-Eth-Trunk1]mode lacp-static &#x0D;&#x0A;&#x0D;&#x0A;[RouteB]int g0/0/1&#x0D;&#x0A;&#x0D;&#x0A;[RouteB-GigabitEthernet0/0/1]eth-trunk 1&#x0D;&#x0A;&#x0D;&#x0A;[RouteB]int g0/0/2&#x0D;&#x0A;[RouteB-GigabitEthernet0/0/2]eth-trunk 1&#x0D;&#x0A;&#x0D;&#x0A;[RouteB]int g0/0/3&#x0D;&#x0A;&#x09;&#x0D;&#x0A;[RouteB-GigabitEthernet0/0/3]eth-trunk 1&#x0D;&#x0A;" fontname="Consolas" fontstyle="0" editsize="100" txtcolor="-16777216" txtbkcolor="-7278960" charset="1" />
